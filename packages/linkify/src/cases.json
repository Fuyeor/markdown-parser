{
  "Domain in text": [
    {
      "text": "Visit fuyeor.com.",
      "expect": "fuyeor.com"
    },
    {
      "text": "Visit fuyeor.com",
      "expect": "fuyeor.com"
    },
    {
      "text": "Visit fuyeor.com;",
