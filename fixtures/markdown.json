{
  "schema_version": 1,
  "description": "Language-neutral Markdown and Fuyeor Flavored Markdown render fixtures.",
  "cases": [
    {
      "id": "heading-with-bold",
      "parser": "standard",
      "source": "## Hello **World**",
      "expected_html": "<h2>Hello <strong>World</strong></h2>\n",
      "tags": [
        "heading",
        "bold"
      ],
      "source_suite": "unit"
    },
    {
      "id": "fenced-code",
      "parser": "standard",
      "source": "```ts\nconst a = 1;\n```",
      "expected_html": "<div class=\"code-block-wrapper\"><div class=\"code-lang\">ts</div><pre><code class=\"language-ts\">const a = 1;\n</code></pre></div>\n",
      "tags": [
        "code"
      ],
      "source_suite": "unit"
    },
    {
      "id": "safe-links",
      "parser": "standard",
      "source": "visit www.fuyeor.com or [click here](https://fuyeor.com)",
      "expected_html": "<p>visit <a href=\"https://www.fuyeor.com\">www.fuyeor.com</a> or <a href=\"https://fuyeor.com\">click here</a></p>\n",
      "tags": [
        "link",
        "linkify"
      ],
      "source_suite": "unit"
    },
    {
      "id": "aligned-table",
      "parser": "ffm",
      "source": "| 属性 | 类型 | 说明 |\n| :--- | :---: | ---: |\n| name | string | 用户名 |",
      "expected_html": "<table>\n<thead>\n<tr>\n<th align=\"left\">属性</th>\n<th align=\"center\">类型</th>\n<th align=\"right\">说明</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">name</td>\n<td align=\"center\">string</td>\n<td align=\"right\">用户名</td>\n</tr>\n</tbody>\n</table>\n",
      "tags": [
        "table",
        "alignment"
      ],
      "source_suite": "unit"
    },
    {
      "id": "headerless-table",
      "parser": "ffm",
      "source": "| :--- | ---: |\n| Ray ID | a2c5ac427b7aa727 |\n| IP 地址 | 172.214.47.18 |",
      "expected_html": "<table>\n<tbody>\n<tr>\n<td align=\"left\">Ray ID</td>\n<td align=\"right\">a2c5ac427b7aa727</td>\n</tr>\n<tr>\n<td align=\"left\">IP 地址</td>\n<td align=\"right\">172.214.47.18</td>\n</tr>\n</tbody>\n</table>\n",
      "tags": [
        "table",
        "headerless"
      ],
      "source_suite": "unit"
    },
    {
      "id": "hardbreak",
      "parser": "standard",
      "source": "line\\\nbreak",
      "expected_html": "<p>line<br />\nbreak</p>\n",
      "tags": [
        "break"
      ],
      "source_suite": "unit"
    },
    {
      "id": "unsafe-link",
      "parser": "ffm",
      "source": "[x](javascript:alert(1))",
      "expected_html": "<p>[x](javascript:alert(1))</p>",
      "tags": [
        "security",
        "link"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-strike",
      "parser": "ffm",
      "source": "--Fuyeor--",
      "expected_html": "<p><del>Fuyeor</del></p>",
      "tags": [
        "ffm",
        "strike"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-underline",
      "parser": "ffm",
      "source": "__Fuyeor__",
      "expected_html": "<p><u>Fuyeor</u></p>",
      "tags": [
        "ffm",
        "underline"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-color-code",
      "parser": "ffm",
      "source": "`#ff0000`",
      "expected_html": "<p><code class=\"ffm-color-code\"><span class=\"ffm-color-swatch\" style=\"display:inline-block;width:0.8em;height:0.8em;border-radius:50%;background-color:#ff0000;vertical-align:middle;margin-right:0.3em;border:1px solid #00000030;\"></span>#ff0000</code></p>",
      "tags": [
        "ffm",
        "color"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-quote",
      "parser": "ffm",
      "source": "```quote\n## Title\n```",
      "expected_html": "<blockquote>\n<h2>Title</h2>\n</blockquote>",
      "tags": [
        "ffm",
        "quote"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-accordion",
      "parser": "ffm",
      "source": "```accordion\n**One**\nContent\n```",
      "expected_html": "<div class=\"ffm-accordion\"><details name=\"acc-0\"><summary>One</summary><div class=\"accordion-content\"><p>Content</p>\n</div></details></div>",
      "tags": [
        "ffm",
        "accordion"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-chain",
      "parser": "ffm",
      "source": "```chain\n**[x] Done**\nBody\n```",
      "expected_html": "<div class=\"chain-container\"><div class=\"chain-item is-completed\"><div class=\"chain-marker\"></div><div class=\"chain-content-wrapper\"><div class=\"chain-title\">Done</div><div class=\"chain-body\"><p>Body</p>\n</div></div></div></div>",
      "tags": [
        "ffm",
        "chain",
        "checkbox"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-slide",
      "parser": "ffm",
      "source": "```slide\nFirst\n\n---\n\nSecond\n```",
      "expected_html": "<div class=\"slide-container-wrapper\"><div class=\"slide-container\"><div class=\"slide-item\"><p>First</p>\n</div><div class=\"slide-item\"><p>Second</p>\n</div></div></div>",
      "tags": [
        "ffm",
        "slide"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-unsafe-data-link",
      "parser": "ffm",
      "source": "[x](data:text/html,<script>alert(1)</script>)",
      "expected_html": "<p>[x](data:text/html,&lt;script&gt;alert(1)&lt;/script&gt;)</p>",
      "tags": [
        "ffm",
        "security",
        "link"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "ffm-unsafe-file-link",
      "parser": "ffm",
      "source": "[x](file:///etc/passwd)",
      "expected_html": "<p>[x](file:///etc/passwd)</p>",
      "tags": [
        "ffm",
        "security",
        "link"
      ],
      "source_suite": "ffm",
      "output_normalization": "trim"
    },
    {
      "id": "malicious-html-as-text",
      "parser": "standard",
      "source_suite": "unit",
      "source": "text <script>alert(1)</script>",
      "expected_html": "<p>text &lt;script&gt;alert(1)&lt;/script&gt;</p>\n",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "paragraph"
        },
        {
          "path": "/0/children/0/content",
          "equals": "text <script>alert(1)</script>"
        }
      ],
      "tags": [
        "security",
        "text"
      ]
    },
    {
      "id": "internationalized-fuzzy-link",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "Visit fuyeor.xn--p1ai",
      "expected_html": "<p>Visit <a href=\"https://fuyeor.рф\">fuyeor.рф</a></p>\n",
      "assertions": [
        {
          "path": "/0/children/1/type",
          "equals": "link"
        },
        {
          "path": "/0/children/1/url",
          "equals": "https://fuyeor.рф"
        },
        {
          "path": "/0/children/1/children/0/content",
          "equals": "fuyeor.рф"
        }
      ],
      "tags": [
        "link",
        "linkify",
        "unicode"
      ]
    },
    {
      "id": "basic-table-ast",
      "parser": "standard",
      "source_suite": "unit",
      "source": "\n| title 1 | title 2 |\n|---|---|\n| content 1 | content 2 |\n",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "table"
        },
        {
          "path": "/0/headers/0/type",
          "equals": "table_cell"
        },
        {
          "path": "/0/headers/1/type",
          "equals": "table_cell"
        },
        {
          "path": "/0/children/0/type",
          "equals": "table_row"
        }
      ],
      "tags": [
        "table",
        "ast"
      ]
    },
    {
      "id": "nested-list-two-space",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "1. example\n  - example",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "list"
        },
        {
          "path": "/0/children/0/children/1/type",
          "equals": "list"
        }
      ],
      "tags": [
        "list",
        "ast"
      ]
    },
    {
      "id": "nested-list-three-space",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "1. example\n   - example",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "list"
        },
        {
          "path": "/0/children/0/children/1/type",
          "equals": "list"
        }
      ],
      "tags": [
        "list",
        "ast"
      ]
    },
    {
      "id": "nested-list-two-space-steps",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "1. root\n   - level 1\n    - level 2",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "list"
        },
        {
          "path": "/0/children/0/children/1/children/0/children/1/type",
          "equals": "list"
        }
      ],
      "tags": [
        "list",
        "ast"
      ]
    },
    {
      "id": "deep-block-does-not-throw",
      "parser": "ffm",
      "source_suite": "unit",
      "source": ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> value",
      "options": {
        "max_nesting_depth": 8
      },
      "expect_no_throw": true,
      "tags": [
        "recursion",
        "safety"
      ]
    },
    {
      "id": "invalid-nesting-depth",
      "operation": "construct",
      "parser": "ffm",
      "source_suite": "unit",
      "options": {
        "max_nesting_depth": 0
      },
      "expected_error": "invalid_nesting_depth",
      "tags": [
        "configuration",
        "error"
      ]
    },
    {
      "id": "ffm-inline-and-quote-ast",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "__under__ and --strike--\n\n```quote\n## nested\n```",
      "assertions": [
        {
          "path": "/0/children/0/type",
          "equals": "underline"
        },
        {
          "path": "/0/children/2/type",
          "equals": "strike"
        },
        {
          "path": "/1/type",
          "equals": "blockquote"
        },
        {
          "path": "/1/children/0/type",
          "equals": "heading"
        }
      ],
      "tags": [
        "ffm",
        "ast"
      ]
    },
    {
      "id": "spaced-slide-separator-ast",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "```slide\nFirst\n\n  ---  \n\nSecond\n```",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "slide"
        },
        {
          "path": "/0/children",
          "length": 2
        }
      ],
      "tags": [
        "ffm",
        "slide",
        "ast"
      ]
    },
    {
      "id": "accordion-state-ast",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "```accordion\n**First**\nBody\n\n**Second**\nMore\n```",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "accordion"
        },
        {
          "path": "/0/children",
          "length": 2
        },
        {
          "path": "/0/children/0/name",
          "equals": "acc-0"
        }
      ],
      "tags": [
        "ffm",
        "accordion",
        "ast"
      ]
    },
    {
      "id": "chain-state-ast",
      "parser": "ffm",
      "source_suite": "unit",
      "source": "```chain\n**[x] Done**\nBody\n```",
      "assertions": [
        {
          "path": "/0/type",
          "equals": "chain"
        },
        {
          "path": "/0/children/0/isCompleted",
          "equals": true
        },
        {
          "path": "/0/children/0/hasCheckbox",
          "equals": true
        }
      ],
      "tags": [
        "ffm",
        "chain",
        "checkbox",
        "ast"
      ]
    },
    {
      "id": "safe-link-https-fuyeor-com",
      "parser": "standard",
      "operation": "safe_link",
      "source_suite": "safety",
      "value": "https://fuyeor.com",
      "expected": true,
      "tags": [
        "security",
        "url"
      ]
    },
