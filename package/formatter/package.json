{
  "name": "@ffm/formatter",
  "version": "0.1.3",
  "description": "Formatter for Fuyeor Flavored Markdown (.ffm) document",
  "license": "MIT",
  "author": "Fuyeor <https://www.fuyeor.com/@Fuyeor>",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run src/index.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@ffm/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
