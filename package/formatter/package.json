{
  "name": "@ffm/formatter",
  "version": "0.1.3",
  "description": "Formatter for Fuyeor Flavored Markdown (.ffm) document",
  "license": "MIT",
  "author": "Fuyeor <https://www.fuyeor.com/@Fuyeor>",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run src/index.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@ffm/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
