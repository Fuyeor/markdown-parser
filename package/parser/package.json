{
  "name": "@ffm/parser",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Fuyeor <https://www.fuyeor.com/@Fuyeor>",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run src/index.spec.ts",
    "test:ffm": "vitest run src/index.spec.ts -t \"ffm fixture\"",
    "test:safety": "vitest run src/index.spec.ts -t \"safety fixture\"",
    "test:compat": "vitest run src/test/index.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin/index.ts"
  },
  "dependencies": {
    "@ffm/linkify": "workspace:*",
    "@fuyeor/util": "^0.1.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
